{
  "name": "cinehub",
  "version": "1.0.0",
  "description": "Aplicacion web para consultar peliculas y comprar boletos de cine. Vanilla JS + TMDB API + JSON Server.",
  "type": "module",
  "private": true,
  "scripts": {
    "api": "json-server --watch db.json --port 3000",
    "dev": "live-server --port=5500",
    "start": "concurrently -n API,WEB -c magenta,green \"npm:api\" \"npm:dev\"",
    "seed": "node scripts/seed.js"
  },
  "keywords": [
    "cinehub",
    "cinema",
    "tmdb",
    "json-server",
    "vanilla-js"
  ],
  "author": "valepallares12@gmail.com",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "9.1.2",
    "json-server": "0.17.4",
    "live-server": "1.2.2"
  }
}
